#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# PRE-PUSH · PUERTA DE ARRASTRE — «este push lleva SOLO commits de esta sesión»
#
# Regla global (Carlos, 2026-07-27): dos sesiones sobre la misma carpeta
# comparten UNA rama; `git push` empuja la RAMA, no «mis cambios». Cada commit
# va firmado por el hook commit-msg; este hook se niega a publicar commits
# firmados por otra sesión, nombrando cada uno y su dueño.
#
# ⚠️ Adaptación mínima para ReasonedWeb: la «puerta 0» de CRM Web (huérfanos
# via scripts/puertas.mjs) NO se porta — es aparato de QA ajeno y este repo
# no la hereda (CLAUDE.md § Lo que NO se hereda). Si este sitio necesita un
# check de huérfanos, se escribirá uno nuevo y mínimo.
#
# 🔓 ARRASTRE_OK=1 git push …  ← adoptar trabajo ajeno a propósito, revisado.
# ─────────────────────────────────────────────────────────────────────────────
set -e

CERO="0000000000000000000000000000000000000000"
MI_ID="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
if [ -n "$MI_ID" ]; then
  MIA="claude:$(printf '%s' "$MI_ID" | tr -d '\r\n' | cut -c1-8)"
else
  MIA="humano"
fi

AJENOS=""
SIN_FIRMA=0
REVISADOS=0

while read -r _lref lsha _rref rsha; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$CERO" ] && continue          # borrado de rama: nada que revisar
  if [ "$rsha" = "$CERO" ] || [ -z "$rsha" ]; then
    RANGO="$lsha --not --remotes=origin"     # rama nueva: lo que no esté ya en origin
  else
    RANGO="$rsha..$lsha"
  fi
  # --no-merges: `git merge` no siempre dispara commit-msg; un merge sin firma no es un ajeno.
  for C in $(git rev-list --no-merges $RANGO 2>/dev/null || true); do
    REVISADOS=$((REVISADOS + 1))
    FIRMA="$(git show -s --format='%(trailers:key=Claude-Session,valueonly)' "$C" 2>/dev/null | tr -d '\r\n ' || true)"
    if [ -z "$FIRMA" ]; then
      SIN_FIRMA=$((SIN_FIRMA + 1))
    elif [ "$FIRMA" != "$MIA" ]; then
      AJENOS="$AJENOS
   · $(git show -s --format='%h  %s' "$C" 2>/dev/null || echo "$C")   ⟵ $FIRMA"
    fi
  done
done

# ⛔ VERDE EN VACÍO: el denominador se publica SIEMPRE, también cuando todo está bien.
echo "· puerta de arrastre: $REVISADOS commit(s) revisados · firma de esta sesión: $MIA" >&2

if [ -n "$AJENOS" ] && [ -z "$ARRASTRE_OK" ]; then
  echo "" >&2
  echo "  ⛔⛔  PUSH DETENIDO — ESTE PUSH ARRASTRA COMMITS DE OTRA SESIÓN" >&2
  echo "$AJENOS" >&2
  echo "" >&2
  echo "   No los escribiste tú y nadie revisó si están terminados." >&2
  echo "   · si la otra sesión sigue viva: que los pushee ELLA" >&2
  echo "   · si los ADOPTAS: revísalos de verdad y luego ARRASTRE_OK=1 git push …" >&2
  echo "   · para ver qué traen:  git show <sha>" >&2
  echo "" >&2
  exit 1
fi

if [ "$SIN_FIRMA" -gt 0 ]; then
  # No bloquea (rebase no reejecuta commit-msg; historia previa al hook no está
  # firmada), pero se NOMBRA: un commit sin dueño es exactamente el agujero.
  echo "⚠ puerta de arrastre: $SIN_FIRMA commit(s) SIN firma de sesión." >&2
fi

if [ -n "$AJENOS" ]; then
  echo "⚠ ARRASTRE_OK=1 — publicando commits ajenos a propósito." >&2
fi

exit 0
