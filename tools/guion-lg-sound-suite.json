    {
      "nombre": "cargar-inside",
      "accion": "esperar_sel",
      "sel": ".ex-slider",
      "max": 30,
      "dur": 4.0
    },
    {
      "nombre": "explosionar",
      "accion": "js",
      "expr": "(() => { const s=document.querySelector('.ex-slider'); if(!s) return; let v=+s.min||0; const max=+s.max||100; const paso=(max-v)/60; const t=setInterval(()=>{ v=Math.min(max*0.82, v+paso); s.value=v; s.dispatchEvent(new Event('input',{bubbles:true})); if(v>=max*0.82) clearInterval(t); }, 45); })()",
      "dur": 5.0
    },
    {
      "nombre": "ver-hotspots",
      "accion": "esperar",
      "dur": 3.0
    },
    {
      "nombre": "abrir-hotspot",
      "accion": "js",
      "expr": "(() => { const d=document.querySelector('.hs-pin.on .hs-dot') || document.querySelector('.hs-dot'); if(d) d.click(); })()",
      "dur": 4.0
    },
    {
      "nombre": "orbitar",
      "accion": "arrastrar",
      "desde": [
